{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-olist-analytics"
		},
		"ls_olist_AzureDataLakeStorage_landing_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_olist_AzureDataLakeStorage_landing'"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-olist-analysis.vault.azure.net/"
		},
		"ls_local_olist_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "D:\\DE DATASETS"
		},
		"ls_local_olist_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "Ganesh\\hp"
		},
		"ls_olist_AzureDataLakeStorage_landing_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stolistanalytics.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-olist-analytics_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_olist_AzureDataLakeStorage_landing_accountKey": {
						"value": "[parameters('ls_olist_AzureDataLakeStorage_landing_accountKey')]"
					},
					"AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"ls_olist_AzureDataLakeStorage_landing_properties_typeProperties_url": {
						"value": "[parameters('ls_olist_AzureDataLakeStorage_landing_properties_typeProperties_url')]"
					},
					"ls_local_olist_properties_typeProperties_host": {
						"value": "[parameters('ls_local_olist_properties_typeProperties_host')]"
					},
					"ls_local_olist_properties_typeProperties_userId": {
						"value": "[parameters('ls_local_olist_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}